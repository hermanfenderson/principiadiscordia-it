---
// Una tavola (o una pagina della scansione) in più larghezze: AVIF con JPEG di riserva.
interface Props {
  img: { larghezza: number; altezza: number; avif: string; jpg: string; src: string };
  alt: string;
  sizes: string;
  prioritaria?: boolean;     // la pagina corrente: niente caricamento pigro
  descrittaDa?: string;      // id del blocco con descrizione e testo
  classe?: string;
}
const { img, alt, sizes, prioritaria = false, descrittaDa, classe } = Astro.props;
---
<picture class={classe}>
  {img.avif && <source type="image/avif" srcset={img.avif} sizes={sizes} />}
  <img
    src={img.src}
    srcset={img.jpg || undefined}
    sizes={sizes}
    alt={alt}
    width={img.larghezza}
    height={img.altezza}
    loading={prioritaria ? 'eager' : 'lazy'}
    fetchpriority={prioritaria ? 'high' : undefined}
    decoding="async"
    aria-describedby={descrittaDa}
    style={`--r: ${img.larghezza / img.altezza}`}
  />
</picture>
