---
// Lo sfogliatore: una pagina del libro per indirizzo, completa anche senza JavaScript.
// Con JavaScript: tasti, swipe, doppia pagina, originale a fronte, tutto schermo.
import Base from '../../layouts/Base.astro';
import Immagine from '../../components/Immagine.astro';
import dati from '../../data/pagine.json';

export function getStaticPaths() {
  return dati.pagine.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
type Pagina = (typeof dati.pagine)[number];
const { p } = Astro.props as { p: Pagina };
const per = Object.fromEntries(dati.pagine.map((q) => [q.slug, q]));
const compagna = p.compagna ? per[p.compagna] : null;
const prima = dati.pagine[0].slug;
const ultima = dati.pagine[dati.pagine.length - 1].slug;
const url = (s: string | null) => (s ? `/libro/${s}/` : undefined);
const sottotitolo = p.voce && p.hill ? p.voce : p.hill ? p.sezione : null;
const SIZES = '(min-width: 60rem) min(46vw, calc((100svh - 11rem) * 0.62)), min(100vw, calc((100svh - 11rem) * 0.62))';
// nel tutto schermo lo script mette questi sizes: l'immagine prende la larghezza di sizes
const SIZES_SCHERMO = '(min-width: 60rem) min(46vw, calc((100svh - 0.5rem) * 0.62)), min(100vw, calc((100svh - 3.5rem) * 0.62))';
// le tavole hanno il testo quasi a filo: sul sito stanno su un foglio con un margine bianco ai lati
// (MARGINE per lato, in frazione della larghezza della tavola), come nel libro A5; copertina e quarta no
const MARGINE = 0.07;
const foglio = (q: { slug: string }) => (['copertina', 'quarta'].includes(q.slug) ? undefined : 'su-foglio');
const proporzione = `${p.immagine.larghezza * (1 + 2 * MARGINE)} / ${p.immagine.altezza}`;
const o = p.originale;
const ass = (x: string) => new URL(x, Astro.site).href;
const briciole = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Principia Discordia', item: ass('/') },
    { '@type': 'ListItem', position: 2, name: 'Indice', item: ass('/libro/') },
    { '@type': 'ListItem', position: 3, name: p.titolo, item: ass(`/libro/${p.slug}/`) },
  ],
};
const altOriginale = o
  ? `Originale inglese: la stessa pagina nell'edizione Loompanics del 1980${o.testo ? '' : ' (testo inglese non ancora trascritto su Wikisource)'}.`
  : '';
---
<Base titolo={p.titolo + (sottotitolo ? ` — ${sottotitolo}` : '')} descrizione={p.alt} sezione="libro" classe="con-sfogliatore"
  immagine={{ src: p.immagine.src, alt: p.alt, larghezza: 1000, altezza: Math.round(1000 * p.immagine.altezza / p.immagine.larghezza) }}
  datiStrutturati={briciole}>
  <Fragment slot="testa">
    <script is:inline>
      (function () {
        var h = document.documentElement, q = new URLSearchParams(location.search);
        try {
          if (localStorage.getItem('pd-doppia') === '1') h.classList.add('doppia');
          if (q.has('a-fronte') || localStorage.getItem('pd-a-fronte') === '1') h.classList.add('a-fronte');
          if (sessionStorage.getItem('pd-schermo') === '1') h.classList.add('schermo');
        } catch (e) { if (q.has('a-fronte')) h.classList.add('a-fronte'); }
        h.classList.add('js');
      })();
    </script>
    {p.succ && <link rel="prefetch" href={url(p.succ)} />}
  </Fragment>

  <div class="sfogliatore" id="sfogliatore">
    <div
      class="pagina-corrente"
      data-titolo={p.titolo}
      data-prec={url(p.prec)} data-succ={url(p.succ)}
      data-prec-doppia={url(p.prec_doppia)} data-succ-doppia={url(p.succ_doppia)}
      data-prima={url(prima)} data-ultima={url(ultima)}
      data-succ-avif={p.succ ? per[p.succ].immagine.avif : undefined}
      data-sizes={SIZES}
      data-sizes-schermo={SIZES_SCHERMO}
      data-originale={o ? 'si' : 'no'}
    >
      <div class="intestazione">
        <details class="menu-pagina">
          <summary><span class="hamburger" aria-hidden="true"><span></span></span><span class="etichetta-menu">Menu</span><span class="solo-lettori"> della pagina</span></summary>
          <div class="pannello">
            <ul class="strumenti">
              <li class="gruppo-fronte">
                <button type="button" class="interruttore solo-js" data-azione="a-fronte" aria-pressed="false"
                  aria-disabled={o ? undefined : 'true'} aria-describedby={o ? undefined : 'senza-originale'}>Originale a fronte</button>
                {!o && <span id="senza-originale" class="avviso">{p.avviso}</span>}
                {o && <a class="senza-js" href={`/libro/${p.slug}/originale/`}>Vedi l'originale inglese</a>}
              </li>
              <li class="solo-js solo-largo"><button type="button" class="interruttore" data-azione="doppia" aria-pressed="false">Doppia pagina</button></li>
              <li class="solo-js"><button type="button" class="pulsante" data-azione="schermo">Tutto schermo</button></li>
              <li><a href={p.immagine.piena}>Apri a piena risoluzione<span class="solo-lettori"> (immagine JPEG)</span></a></li>
            </ul>
            <p class="nota-accessibile">
              Ogni pagina ha descrizione e testo completo per chi usa uno screen reader.
              <a href="/accessibilita/">Accessibilità e tasti</a>
            </p>
          </div>
        </details>
        <h1 class="titolo-pagina">
          <span class="numero">{p.titolo}</span>
          {sottotitolo && <span class="sottotitolo">{sottotitolo}</span>}
        </h1>
        <p class="posizione">{p.posizione}</p>
      </div>

      <div class={`palco lato-${p.lato}${o ? ' ha-originale' : ''}`}>
        {o && (
          <figure class="originale" aria-labelledby="originale-etichetta">
            <figcaption>
              <span class="etichetta" id="originale-etichetta">Originale inglese</span>
            </figcaption>
            <Immagine img={o.immagine} alt={altOriginale} sizes={SIZES} descrittaDa={o.testo ? 'testo-originale' : undefined} />
            <p class="fonte">
              {o.testo ? <a href={o.wikisource}>testo su Wikisource</a> : <span>testo non ancora su Wikisource</span>}
              · <a href={o.commons}>scansione su Wikimedia Commons</a>
            </p>
          </figure>
        )}
        {p.lato === 'destra' && (
          compagna ? (
            <a class="compagna" href={url(compagna.slug)}>
              <Immagine img={compagna.immagine} alt={`${compagna.titolo} (pagina a fronte): ${compagna.alt}`} sizes={SIZES} classe={foglio(compagna)} />
            </a>
          ) : <div class="compagna vuota" aria-hidden="true" style={`aspect-ratio: ${proporzione}`}></div>
        )}
        <figure class="corrente" aria-label={o ? 'Traduzione italiana' : undefined}>
          <Immagine img={p.immagine} alt={p.alt} sizes={SIZES} prioritaria descrittaDa="testo-pagina" classe={foglio(p)} />
        </figure>
        {p.lato === 'sinistra' && (
          compagna ? (
            <a class="compagna" href={url(compagna.slug)}>
              <Immagine img={compagna.immagine} alt={`${compagna.titolo} (pagina a fronte): ${compagna.alt}`} sizes={SIZES} classe={foglio(compagna)} />
            </a>
          ) : <div class="compagna vuota" aria-hidden="true" style={`aspect-ratio: ${proporzione}`}></div>
        )}
      </div>

      <nav class="sfoglia" aria-label="Sfoglia il libro">
        {p.prec ? <a class="vai prec" href={url(p.prec)} rel="prev"><span aria-hidden="true">←</span> Precedente</a>
                : <span class="vai prec spento">Inizio del libro</span>}
        <a class="vai indice" href="/libro/">Indice</a>
        {p.succ ? <a class="vai succ" href={url(p.succ)} rel="next">Successiva <span aria-hidden="true">→</span></a>
                : <span class="vai succ spento">Fine del libro</span>}
      </nav>

      {o?.testo && (
        <section id="testo-originale" class="solo-lettori testo-originale" aria-labelledby="testo-originale-titolo">
          <h2 id="testo-originale-titolo">Originale inglese: testo della pagina</h2>
          <div lang="en"><Fragment set:html={o.testo} /></div>
          <p>Trascrizione dei volontari di Wikisource, licenza CC BY-SA 4.0: <a href={o.wikisource}>pagina di Wikisource</a>.</p>
        </section>
      )}
      <section id="testo-pagina" class="solo-lettori" aria-labelledby="testo-pagina-titolo">
        <h2 id="testo-pagina-titolo">Descrizione e testo della pagina</h2>
        <h3>Descrizione dell'immagine</h3>
        <Fragment set:html={p.descrizione} />
        <h3>Testo della pagina</h3>
        <div class="testo"><Fragment set:html={p.testo} /></div>
      </section>
    </div>

    <div class="barra-schermo" hidden>
      <button type="button" class="freccia" data-azione="prec"><span aria-hidden="true">←</span><span class="solo-lettori">Pagina precedente</span></button>
      <button type="button" class="esci" data-azione="esci-schermo">Esci<span class="solo-lettori"> dal tutto schermo</span> <span aria-hidden="true">✕</span></button>
      <button type="button" class="freccia" data-azione="succ"><span aria-hidden="true">→</span><span class="solo-lettori">Pagina successiva</span></button>
    </div>
    <p class="solo-lettori" aria-live="polite" id="annuncio"></p>
  </div>
</Base>

<script>
  import '../../scripts/sfogliatore';
</script>

<style is:global>
  .con-sfogliatore .piede { font-size: 0.9rem; }
  .sfogliatore { max-width: 100rem; margin: 0 auto; padding: 0.5rem 0.75rem 1.5rem; font-family: var(--f-ui); }
  .intestazione { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.75rem; position: relative; }

  /* menu della pagina: <details>, si apre e si chiude anche senza JavaScript */
  .menu-pagina > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.55rem;
    min-height: 44px; padding: 0 0.8rem 0 0.75rem; border: 2px solid var(--inchiostro); border-radius: 4px; background: var(--carta);
    font-weight: 500; }
  .menu-pagina > summary::-webkit-details-marker { display: none; }
  .menu-pagina > summary:hover, .menu-pagina[open] > summary { background: var(--ocra); }
  .hamburger, .hamburger::before, .hamburger::after, .hamburger > span { display: block; width: 20px; height: 2px; background: var(--inchiostro); }
  .hamburger { position: relative; background: none; }
  .hamburger > span { position: absolute; top: 0; }
  .hamburger::before, .hamburger::after { content: ""; position: absolute; }
  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }
  .menu-pagina[open] .hamburger > span { opacity: 0; }
  .menu-pagina[open] .hamburger::before { top: 0; transform: rotate(45deg); }
  .menu-pagina[open] .hamburger::after { top: 0; transform: rotate(-45deg); }
  .pannello { position: absolute; z-index: 20; top: calc(100% + 0.35rem); left: 0; width: min(22rem, calc(100vw - 1.5rem));
    padding: 0.9rem 1rem; background: var(--carta); border: 2px solid var(--inchiostro); box-shadow: 0 4px 16px rgb(20 18 16 / 0.3); }
  .titolo-pagina { margin: 0.25rem 0; font-size: 1.15rem; font-weight: 500; line-height: 1.3; }
  .titolo-pagina .numero { font-family: var(--f-macchina); font-weight: 500; }
  .titolo-pagina .sottotitolo::before { content: " — "; }
  .posizione { margin: 0; font-size: 0.85rem; color: var(--grigio); }

  /* larghezza esplicita dalla proporzione (--r, messa sull'immagine): niente salti mentre carica */
  .palco { --alto: max(22rem, calc(100svh - 12.5rem)); --largo: calc(100vw - 1.5rem); display: flex; justify-content: center; align-items: flex-start; gap: 0; margin: 0.5rem 0; }
  .palco picture, .palco img { display: block; }
  .palco figure { margin: 0; }
  /* --w: larghezza della tavola; --m: margine bianco per lato (in frazione di --w), solo sui fogli */
  .palco img {
    --w: min(calc(var(--largo) / (1 + 2 * var(--m, 0))), calc(var(--alto) * var(--r, 0.62)));
    box-sizing: content-box; width: var(--w); padding: 0 calc(var(--w) * var(--m, 0));
    height: auto; max-width: none;
    background: #fff;
    box-shadow: 0 1px 0 var(--inchiostro), 0 2px 10px rgb(20 18 16 / 0.25);
  }
  .palco .su-foglio img { --m: 0.07; }
  .compagna, .originale { display: none; }

  /* doppia pagina, solo su schermi larghi: pari a sinistra, dispari a destra */
  @media (min-width: 60rem) {
    .doppia .palco .compagna { display: block; flex: 0 1 auto; }
    .doppia .palco .compagna.vuota { height: var(--alto); background: transparent; }
    .doppia .palco { --largo: calc(50vw - 1rem); }
    .doppia .palco img { box-shadow: 0 2px 10px rgb(20 18 16 / 0.25); }
    .doppia .palco .compagna:hover img { outline: 2px solid var(--inchiostro); }
  }

  /* originale a fronte: vince sulla doppia pagina. Largo: originale a sinistra, traduzione a destra;
     stretto: l'originale prende il posto della traduzione */
  .a-fronte .palco.ha-originale .compagna { display: none !important; }
  .a-fronte .palco.ha-originale .originale { display: block; }
  .originale figcaption { text-align: center; margin-bottom: 0.3rem; }
  .originale .etichetta { font-family: var(--f-timbro); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--rosso-timbro); border: 2px solid currentColor; padding: 0 0.5rem; border-radius: 3px; }
  .originale .fonte { font-size: 0.85rem; text-align: center; margin: 0.35rem 0 0; }
  .originale img { --alto-o: calc(var(--alto) - 3.5rem); --w: min(calc(var(--largo) / (1 + 2 * var(--m, 0))), calc(var(--alto-o) * var(--r, 0.62))); }
  @media (min-width: 60rem) {
    .a-fronte .palco.ha-originale { gap: 1.25rem; }
    .a-fronte .palco.ha-originale { --largo: calc(50vw - 1.5rem); }
    .a-fronte .palco.ha-originale .corrente { padding-top: 1.85rem; }
    .a-fronte .palco.ha-originale .corrente img { --w: min(calc(var(--largo) / (1 + 2 * var(--m, 0))), calc((var(--alto) - 3.5rem) * var(--r, 0.62))); }
  }
  @media not (min-width: 60rem) {
    .a-fronte .palco.ha-originale .corrente { display: none; }
    .solo-largo { display: none !important; }
  }

  .sfoglia { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.5rem;
    max-width: 40rem; margin: 0.5rem auto 0; }
  .vai { font-weight: 500; text-decoration: none; padding: 0.55rem 0.9rem; border: 2px solid var(--inchiostro);
    background: var(--carta); min-height: 44px; display: inline-flex; align-items: center; gap: 0.4rem; }
  .vai:hover { background: var(--ocra); }
  .vai.prec { justify-self: start; }
  .vai.succ { justify-self: end; }
  .vai.spento { border-style: dashed; color: var(--grigio); background: transparent; }
  .vai.indice { border-color: transparent; text-decoration: underline; }
  /* telefoni stretti: «Indice» sotto, così Precedente e Successiva non escono dallo schermo */
  @media (max-width: 26rem) {
    .sfoglia { grid-template-columns: 1fr 1fr; }
    .vai.indice { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
  }

  .strumenti { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; font-size: 0.95rem; }
  .solo-js { display: none; }
  .js .solo-js { display: inline-block; }
  .js .senza-js { display: none; }
  .gruppo-fronte { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.6rem; }
  .avviso { display: none; font-family: var(--f-mano); color: var(--grigio); }
  .js .avviso { display: inline; }
  .interruttore, .pulsante { font: inherit; font-weight: 500; min-height: 44px; padding: 0.45rem 0.9rem; cursor: pointer;
    background: var(--carta); color: var(--inchiostro); border: 2px solid var(--inchiostro); border-radius: 2rem; position: relative; }
  .interruttore { padding-left: 2.1rem; }
  .interruttore::before { content: ""; position: absolute; left: 0.6rem; top: 50%; width: 1rem; height: 1rem; margin-top: -0.5rem;
    border: 2px solid var(--inchiostro); border-radius: 50%; background: transparent; }
  .interruttore[aria-pressed="true"] { background: var(--ocra); }
  .interruttore[aria-pressed="true"]::before { background: var(--inchiostro); }
  .interruttore[aria-disabled="true"] { border-style: dashed; color: var(--grigio); cursor: not-allowed; background: transparent; }
  .interruttore[aria-disabled="true"]::before { border-color: var(--grigio); background: transparent; }
  .pulsante { border-radius: 4px; }
  .pulsante:hover, .interruttore:not([aria-disabled="true"]):hover { background: var(--ocra); }
  .nota-accessibile { font-size: 0.9rem; margin: 0.9rem 0 0; padding-top: 0.7rem; border-top: 1px solid var(--grigio); color: var(--grigio); }
  .nota-accessibile a { color: var(--inchiostro); }

  /* tutto schermo: il foglio a tutta altezza, frecce piccole ai lati, «Esci» in un angolo.
     Con l'API Fullscreen quando c'è, altrimenti (iPhone) la stessa vista sopra il resto della finestra */
  .schermo .sfogliatore { position: fixed; inset: 0; z-index: 50; max-width: none; margin: 0; padding: 0;
    background: var(--carta); overflow: auto; }
  .schermo .sfogliatore .pagina-corrente { min-height: 100%; display: flex; align-items: center; justify-content: center; padding: 0.25rem 3.25rem; }
  .schermo .intestazione, .schermo .sfoglia, .schermo .strumenti, .schermo .nota-accessibile,
  .schermo .originale .fonte { display: none; }
  .schermo .palco { --alto: calc(100svh - 0.5rem); --largo: calc(100vw - 6.5rem); margin: 0; }
  @media (min-width: 60rem) { .schermo.doppia .palco, .schermo.a-fronte .palco.ha-originale { --largo: calc(50vw - 3.5rem); } }
  .schermo .originale figcaption { position: absolute; margin: 0; padding: 0.2rem; }
  .schermo .originale { position: relative; }
  .schermo .originale img, .schermo.a-fronte .palco.ha-originale .corrente img { --w: min(calc(var(--largo) / (1 + 2 * var(--m, 0))), calc(var(--alto) * var(--r, 0.62))); }
  .schermo.a-fronte .palco.ha-originale .corrente { padding-top: 0; }
  .schermo body { overflow: hidden; }
  .schermo .barra-schermo { display: block !important; }
  .barra-schermo button { font: inherit; font-weight: 500; cursor: pointer; color: var(--inchiostro);
    background: rgb(251 247 236 / 0.9); border: 2px solid var(--inchiostro); position: fixed; z-index: 60; }
  .barra-schermo .freccia { top: 50%; transform: translateY(-50%); width: 2.75rem; height: 2.75rem; border-radius: 50%;
    font-size: 1.3rem; line-height: 1; padding: 0; }
  .barra-schermo [data-azione="prec"] { left: 0.25rem; }
  .barra-schermo [data-azione="succ"] { right: 0.25rem; }
  .barra-schermo .esci { top: 0.25rem; right: 0.25rem; min-height: 2.75rem; padding: 0.3rem 0.7rem; border-radius: 4px; font-size: 0.85rem; }
  .barra-schermo .freccia:hover, .barra-schermo .esci:hover { background: var(--ocra); }
  .barra-schermo .freccia:disabled { border-style: dashed; color: var(--grigio); cursor: default; opacity: 0.6; }
  @media (max-width: 40rem) {
    .schermo .sfogliatore .pagina-corrente { padding: 0.25rem 0; }
    .schermo .palco { --alto: calc(100svh - 3.5rem); --largo: 100vw; }
    .barra-schermo .freccia { top: auto; bottom: 0.25rem; transform: none; }
  }
</style>
